{
  "name": "fiveprotect",
  "version": "0.1.0",
  "private": true,
  "description": "Hardware-gestütztes Anticheat für FiveM — Monorepo",
  "license": "SEE LICENSE IN LICENSE",
  "author": "coazy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coazy/FiveProtect.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "resources/*",
    "apps/companion/ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:lua": "lua tools/lua/run-all.lua",
    "protocol:generate": "npm run generate -w @fiveprotect/protocol",
    "protocol:check": "npm run check -w @fiveprotect/protocol",
    "verify": "npm run lint && npm run typecheck && npm run protocol:check && npm test && npm run test:lua"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
