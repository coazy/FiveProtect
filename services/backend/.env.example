# Copy to .env for local development. Never commit a filled-in copy.

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fiveprotect

# Where the service listens.
HOST=127.0.0.1
PORT=8080

# trace | debug | info | warn | error
LOG_LEVEL=info

# Base URL the companion is told to attest to. Must be reachable from player machines.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Seals the pending nonce at rest, so a database dump alone cannot be replayed against a
# live gate (ADR 0010). 32 bytes as hex — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates every nonce still in flight, which is at most 30 seconds of them.
NONCE_SEAL_KEY=

# Trust X-Forwarded-For. Only enable behind a proxy you control — otherwise a client can
# forge the source address the relay check depends on (design document 5.4).
TRUST_PROXY=false
