{
  "name": "@fiveprotect/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mandantenfähiges Backend: Nonce, Attestation, Verdikt, Sessions",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "vitest run",
    "provision": "tsx --env-file-if-exists=.env src/cli/provision.ts",
    "accept-build": "tsx --env-file-if-exists=.env src/cli/accept-build.ts",
    "policy": "tsx --env-file-if-exists=.env src/cli/policy.ts"
  },
  "dependencies": {
    "@fiveprotect/protocol": "*",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
